# App
APP_ENV=development
APP_PORT=8080
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080
TZ=Asia/Bangkok

# PostgreSQL
POSTGRES_USER=parking
POSTGRES_PASSWORD=parking_secret
POSTGRES_DB=parking_system
POSTGRES_PORT=5432
DATABASE_URL=postgres://parking:parking_secret@localhost:5432/parking_system?sslmode=disable

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# JWT Auth
JWT_ACCESS_SECRET=change-me-access-secret-32-chars-min
JWT_REFRESH_SECRET=change-me-refresh-secret-32-chars-min
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_HOURS=168

# 2C2P Payment Gateway (PGW API v4)
TWOC2P_ENV=sandbox
TWOC2P_MERCHANT_ID=
TWOC2P_SECRET_KEY=
TWOC2P_RETURN_URL=http://localhost:3000/checkout/result
TWOC2P_BACKEND_WEBHOOK_URL=http://localhost:8080/api/v1/webhooks/2c2p

# LINE OA / LINE Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_STAFF_GROUP_ID=

# AviationStack (Flight Lookup)
AVIATIONSTACK_API_KEY=

# Legacy WordPress MySQL (used only by cmd/migrate-wp)
WP_MYSQL_DSN=root:root@tcp(127.0.0.1:10005)/local?parseTime=true
WP_TABLE_PREFIX=wp_

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
